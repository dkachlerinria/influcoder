# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Env
.env
.venv
env/
venv/

# Logs / caches
*.log
wandb/
.cache
.pytest_cache/

# Pipeline outputs (models, gradients, encoders, scores) -- regenerated by the scripts
runs_out/

# Gradient-feature cache (baselines/common.py's ground_truth/train_features) --
# multi-GB, keyed by preset+config, regenerated on demand.
baselines/cache/

# Scratch run logs from ad hoc sweeps/tuning sessions.
.tuning_logs/

# NOTE: data/ (BBH eval subset) and dolly/ (dolly_data.jsonl) are intentionally
# NOT ignored -- they're small, fixed inputs checked in for reproducibility.
# baselines/out/ (tables, plots) is also intentionally NOT ignored -- those
# are the actual results, not scratch.

# flock sentinels created by save_summary() at runtime
*.lock
# cached teacher gradients (regenerable, large)
EXP2-datelm/results/_grad_cache/
EXP2-datelm/results_hardratio_stability/
